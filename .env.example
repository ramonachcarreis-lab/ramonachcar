# Google Maps — OPCIONAL (sem isso: OpenStreetMap grátis no servidor)
VITE_GOOGLE_MAPS_API_KEY="sua_chave_google_maps"
GOOGLE_MAPS_API_KEY=""
# Ordem de provedores: google,osm,estimate
MAPS_PROVIDER_PRIORITY="google,osm,estimate"
# OSRM público (ou self-hosted)
OSRM_BASE_URL="https://router.project-osrm.org"

# Gemini AI (opcional — integrações futuras)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL pública do app (links assinatura, WhatsApp, Render CORS)
APP_URL="http://localhost:3000"
# Build Netlify: URL do backend Render (proxy /api)
NETLIFY_API_URL=""
# Front (opcional se API em outro domínio sem proxy)
VITE_API_BASE_URL=""
VITE_APP_URL=""

# Web Push — gere com: npx tsx scripts/generate-vapid.ts
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@playlivery.com.br"

# WhatsApp Business Cloud API (Meta) — opcional, envio automático
# https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Dono da rede: alertas WhatsApp automáticos (licenciados não veem isso no app)
ADMIN_NOTIFY_PHONE=""
ADMIN_NOTIFY_WHATSAPP_AUTO="false"
